#include "windows.h"
#include "listapp.h"

IDI_LIST    ICON    listapp.ico

ListAppMenu MENU
BEGIN
    POPUP   "&File"
    BEGIN
        MENUITEM "E&xit", IDM_EXIT
    END
    POPUP   "&List"
    BEGIN
        MENUITEM "&Create", IDM_CREATE
        MENUITEM "&Free", IDM_FREE, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Length", IDM_LENGTH, GRAYED
        MENUITEM "&Reverse", IDM_REVERSE, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "C&heck", IDM_CHECK, GRAYED
    END
    POPUP   "Li&nk"
    BEGIN
        MENUITEM "&Insert...", IDM_INSERT, GRAYED
        MENUITEM "&Append...", IDM_APPEND, GRAYED
        MENUITEM "&Push...", IDM_PUSH, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "P&op", IDM_POP, GRAYED
        MENUITEM "&Delete", IDM_DELETE, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Nth...", IDM_NTH, GRAYED
        MENUITEM "&Last", IDM_LAST, GRAYED
    END
    POPUP   "&Value"
    BEGIN
        MENUITEM "&Find...", IDM_FIND, GRAYED
        MENUITEM "&Position...", IDM_POSITION, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Delete...", IDM_DELETE_VALUE, GRAYED
        MENUITEM "Delete &Occurrences...", IDM_DELETE_OCCURRENCES, GRAYED
    END
    POPUP   "&Error"
    BEGIN
        MENUITEM "Bad Memory &Pool", IDM_BAD_POOL, GRAYED
        MENUITEM "Bad &Pointer", IDM_BAD_POINTER, GRAYED
        MENUITEM "&Double Free", IDM_DOUBLE_FREE, GRAYED
        MENUITEM "&Fixed Size", IDM_FIXED_SIZE, GRAYED
    END
    POPUP   "&Help"
    BEGIN
        MENUITEM "&About...", IDM_ABOUT
    END
END

AboutBox DIALOG 22, 17, 144, 35
STYLE DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "About List Manager"
BEGIN
    CTEXT "SmartHeap C++"       -1, 0,  5, 144,  8
    CTEXT "Example Application" -1, 0, 14, 144,  8
    DEFPUSHBUTTON "OK"          IDOK,      53, 59,  32, 14, WS_GROUP
END

GetValue DIALOG 10, 10, 110, 70
STYLE DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "List Manager"
BEGIN
    LTEXT "",               IDC_TEXT, 4,  4, 100, 25
    EDITTEXT                IDC_EDIT, 4, 28, 100, 12, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK",     IDOK,    20, 50,  30, 14
    PUSHBUTTON "Cancel",    IDCANCEL,55, 50,  30, 14
END

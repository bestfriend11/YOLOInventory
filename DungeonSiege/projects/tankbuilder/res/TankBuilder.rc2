/////////////////////////////////////////////////////////////////////////////
//
// Version
//

#include "..\TankBuilderVersion.h"
#include "..\..\lib projects\gpcore\gpcoredefs.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION TB1_VERSION_INT
 PRODUCTVERSION TB1_VERSION_INT
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "Author",           "Scott Bilas\0"
			VALUE "BuildTimestamp",   BUILD_TIMESTAMP
			VALUE "BuildType",        COMPILE_MODE_TEXT
			VALUE "CompanyName",      COMPANY_NAME
			VALUE "FileDescription",  "Dungeon Siege Tank Builder Tool\0"
			VALUE "FileVersion",      TB1_VERSION_TEXT
			VALUE "LegalCopyright",   COPYRIGHT_TEXT
			VALUE "MSQAVersion",      TB1_VERSION_MSQA
			VALUE "OriginalFilename", "TankBuilder\0"
			VALUE "ProductName",      DS1TK_PRODUCT_NAME
			VALUE "ProductVersion",   TB1_VERSION_SHORT
#			if SPECIAL_BUILD
			VALUE "SpecialBuild",     TB1_SPECIAL_BUILD
#			endif
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END

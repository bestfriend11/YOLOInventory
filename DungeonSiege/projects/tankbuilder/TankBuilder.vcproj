<?xml version="1.0" encoding = "Windows-1252"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="7.00"
	Name="TankBuilder"
	SccProjectName="&quot;$/GPG/Projects/TankBuilder&quot;, QUIFAAAA"
	SccAuxPath=""
	SccLocalPath="."
	SccProvider="MSSCCI:Perforce SCM">
	<Platforms>
		<Platform
			Name="Win32"/>
	</Platforms>
	<Configurations>
		<Configuration
			Name="Release|Win32"
			OutputDirectory="\temp\vc7\tankbuilder\Release"
			IntermediateDirectory="\temp\vc7\tankbuilder\Release"
			ConfigurationType="1"
			UseOfMFC="0"
			ATLMinimizesCRunTimeLibraryUsage="FALSE">
			<Tool
				Name="VCCLCompilerTool"
				Optimization="1"
				InlineFunctionExpansion="2"
				OptimizeForProcessor="2"
				PreprocessorDefinitions="WIN32,NDEBUG,_CONSOLE"
				StringPooling="TRUE"
				ExceptionHandling="FALSE"
				RuntimeLibrary="0"
				BufferSecurityCheck="FALSE"
				EnableFunctionLevelLinking="TRUE"
				UsePrecompiledHeader="3"
				PrecompiledHeaderThrough="Precomp_TankBuilder.h"
				PrecompiledHeaderFile="\temp\vc7\tankbuilder\Release/TankBuilder.pch"
				AssemblerListingLocation="\temp\vc7\tankbuilder\Release/"
				ObjectFile="\temp\vc7\tankbuilder\Release/"
				ProgramDataBaseFileName="\temp\vc7\tankbuilder\Release/"
				WarningLevel="3"
				SuppressStartupBanner="TRUE"
				DebugInformationFormat="3"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				AdditionalOptions="/MACHINE:I386"
				AdditionalDependencies="shlw32mt.lib odbc32.lib odbccp32.lib dsound.lib dxguid.lib winmm.lib"
				OutputFile="../../../Build/TankBuilder.exe"
				LinkIncremental="1"
				SuppressStartupBanner="TRUE"
				ForceSymbolReferences="_SmartHeap_malloc"
				GenerateDebugInformation="TRUE"
				ProgramDatabaseFile="\temp\vc7\tankbuilder\Release/TankBuilder.pdb"
				SubSystem="1"
				OptimizeReferences="2"/>
			<Tool
				Name="VCMIDLTool"
				TypeLibraryName="\temp\vc7\tankbuilder\Release/TankBuilder.tlb"/>
			<Tool
				Name="VCPostBuildEventTool"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"
				PreprocessorDefinitions="NDEBUG"
				Culture="1033"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCWebDeploymentTool"/>
		</Configuration>
		<Configuration
			Name="Debug|Win32"
			OutputDirectory="\temp\vc7\tankbuilder\Debug"
			IntermediateDirectory="\temp\vc7\tankbuilder\Debug"
			ConfigurationType="1"
			UseOfMFC="0"
			ATLMinimizesCRunTimeLibraryUsage="FALSE">
			<Tool
				Name="VCCLCompilerTool"
				Optimization="0"
				PreprocessorDefinitions="WIN32,_DEBUG,_CONSOLE"
				ExceptionHandling="FALSE"
				BasicRuntimeChecks="3"
				RuntimeLibrary="1"
				BufferSecurityCheck="FALSE"
				UsePrecompiledHeader="3"
				PrecompiledHeaderThrough="Precomp_TankBuilder.h"
				PrecompiledHeaderFile="\temp\vc7\tankbuilder\Debug/TankBuilder.pch"
				AssemblerListingLocation="\temp\vc7\tankbuilder\Debug/"
				ObjectFile="\temp\vc7\tankbuilder\Debug/"
				ProgramDataBaseFileName="\temp\vc7\tankbuilder\Debug/"
				WarningLevel="4"
				SuppressStartupBanner="TRUE"
				DebugInformationFormat="3"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				AdditionalOptions="/MACHINE:I386"
				AdditionalDependencies="odbc32.lib odbccp32.lib dsound.lib dxguid.lib winmm.lib"
				OutputFile="../../../Build/TankBuilder.exe"
				LinkIncremental="2"
				SuppressStartupBanner="TRUE"
				GenerateDebugInformation="TRUE"
				ProgramDatabaseFile="\temp\vc7\tankbuilder\Debug/TankBuilder.pdb"
				SubSystem="1"/>
			<Tool
				Name="VCMIDLTool"
				TypeLibraryName="\temp\vc7\tankbuilder\Debug/TankBuilder.tlb"/>
			<Tool
				Name="VCPostBuildEventTool"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"
				PreprocessorDefinitions="_DEBUG"
				Culture="1033"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCWebDeploymentTool"/>
		</Configuration>
	</Configurations>
	<Files>
		<Filter
			Name="Source Files"
			Filter="cpp;c;cxx;rc;def;r;odl;idl;hpj;bat">
			<File
				RelativePath=".\Filters.cpp">
			</File>
			<File
				RelativePath=".\Main.cpp">
			</File>
			<File
				RelativePath=".\Spec.cpp">
			</File>
		</Filter>
		<Filter
			Name="Header Files"
			Filter="h;hpp;hxx;hm;inl">
			<File
				RelativePath=".\Filters.h">
			</File>
			<File
				RelativePath=".\Main.h">
			</File>
			<File
				RelativePath=".\Spec.h">
			</File>
			<File
				RelativePath=".\TankBuilderVersion.h">
			</File>
		</Filter>
		<Filter
			Name="Resource Files"
			Filter="ico;cur;bmp;dlg;rc2;rct;bin;rgs;gif;jpg;jpeg;jpe">
			<File
				RelativePath=".\Res\Resource.h">
			</File>
			<File
				RelativePath=".\Res\TankBuilder.rc">
				<FileConfiguration
					Name="Release|Win32">
					<Tool
						Name="VCResourceCompilerTool"
						AdditionalIncludeDirectories="Res;$(NoInherit)"/>
				</FileConfiguration>
				<FileConfiguration
					Name="Debug|Win32">
					<Tool
						Name="VCResourceCompilerTool"
						AdditionalIncludeDirectories="Res;$(NoInherit)"/>
				</FileConfiguration>
			</File>
			<File
				RelativePath=".\Res\TankBuilder.rc2">
			</File>
			<File
				RelativePath=".\Res\app.ico">
			</File>
		</Filter>
		<Filter
			Name="VC7 Code"
			Filter="">
			<File
				RelativePath="..\..\lib\vc7obj\chkesp.obj">
			</File>
			<File
				RelativePath="..\..\lib\vc7obj\ftol2.obj">
			</File>
			<File
				RelativePath="..\..\lib\vc7obj\rtc.lib">
			</File>
			<File
				RelativePath="..\..\lib\vc7obj\sehprolg.obj">
			</File>
		</Filter>
		<Filter
			Name="Precompiled Header"
			Filter="">
			<File
				RelativePath=".\Precomp_TankBuilder.cpp">
				<FileConfiguration
					Name="Release|Win32">
					<Tool
						Name="VCCLCompilerTool"
						UsePrecompiledHeader="1"/>
				</FileConfiguration>
				<FileConfiguration
					Name="Debug|Win32">
					<Tool
						Name="VCCLCompilerTool"
						UsePrecompiledHeader="1"/>
				</FileConfiguration>
			</File>
			<File
				RelativePath=".\Precomp_TankBuilder.h">
			</File>
		</Filter>
	</Files>
	<Globals>
	</Globals>
</VisualStudioProject>

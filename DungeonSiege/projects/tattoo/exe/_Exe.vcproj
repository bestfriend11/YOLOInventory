			<Tool
				Name="VCLinkerTool"
				AdditionalOptions="/MACHINE:I386"
				AdditionalDependencies="shlw32mt.lib libcmt.lib libcpmt.lib binkw32.lib dplayx.lib ddraw.lib d3dim.lib"
				OutputFile="Retail/DungeonSiege.exe"
				LinkIncremental="1"
				SuppressStartupBanner="TRUE"
				ForceSymbolReferences="_SmartHeap_malloc"
				GenerateDebugInformation="TRUE"
				ProgramDatabaseFile="\temp\vc7\Tattoo\_Exe\Retail/DungeonSiege.pdb"
				SubSystem="2"
				OptimizeReferences="0"/>
			<Tool
				Name="VCMIDLTool"
				PreprocessorDefinitions="NDEBUG"
				MkTypLibCompatible="TRUE"
				SuppressStartupBanner="TRUE"
				TargetEnvironment="1"
				TypeLibraryName="\temp\vc7\Tattoo\_Exe\Retail/_Exe.tlb"/>
			<Tool
				Name="VCPostBuildEventTool"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"
				PreprocessorDefinitions="NDEBUG,RETAIL_ICON"
				Culture="1033"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCWebDeploymentTool"/>

/////////////////////////////////////////////////////////////////////////////
//
// Toolbar
//

IDR_MAINFRAME TOOLBAR DISCARDABLE  16, 15
BEGIN
    BUTTON      ID_FILE_NEW_INTERFACE
    BUTTON      ID_FILE_OPEN_INTERFACE
    BUTTON      ID_FILE_SAVE_INTERFACE
    SEPARATOR
    BUTTON      ID_EDIT_CUT
    BUTTON      ID_EDIT_COPY
    BUTTON      ID_EDIT_PASTE
    SEPARATOR
    BUTTON      ID_FILE_PRINT
    SEPARATOR
    BUTTON      ID_APP_ABOUT
END

IDR_TOOLBAR_MODE TOOLBAR DISCARDABLE  16, 15
BEGIN
    BUTTON      ID_MODE_CREATION
    BUTTON      ID_MODE_STRUCTURE
    BUTTON      ID_MODE_UVSMARTMAP
    BUTTON      ID_MODE_UVEDIT
    BUTTON      ID_MODE_GUIDEEDIT
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_FILE_NEW_INTERFACE
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN_INTERFACE
        MENUITEM "&Save\tCtrl+S",               ID_FILE_SAVE_INTERFACE
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Close Interfaces",           ID_FILE_CLOSEINTERFACES
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",               ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",                ID_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",              ID_EDIT_PASTE
        MENUITEM SEPARATOR
        MENUITEM "&Delete",                     ID_EDIT_DELETE
        MENUITEM SEPARATOR
        MENUITEM "Set Background",              ID_EDIT_SET_BACKGROUND
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
        MENUITEM "&Controls",                   ID_VIEW_CONTROLS
        MENUITEM "&Interfaces",                 ID_VIEW_INTERFACES
        MENUITEM SEPARATOR
        MENUITEM "&Preferences",                ID_VIEW_PREFERENCES
    END
    POPUP "&Mode"
    BEGIN
        MENUITEM "&Creation",                   ID_MODE_CREATION, CHECKED
        MENUITEM "&Structure",                  ID_MODE_STRUCTURE
        MENUITEM "&UV &Smart Map",              ID_MODE_UVSMARTMAP
        MENUITEM "UV &Edit",                    ID_MODE_UVEDIT
        MENUITEM "&Guide Edit",                 ID_MODE_GUIDEEDIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About GUIMaster...",         ID_APP_ABOUT
    END
    POPUP "Localization Tools"
    BEGIN
        MENUITEM "Create GUI ID Map",           ID_LOCALIZATIONTOOLS_CREATEGUIIDMAP

    END
END



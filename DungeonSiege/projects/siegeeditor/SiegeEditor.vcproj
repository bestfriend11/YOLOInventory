<?xml version="1.0" encoding = "Windows-1252"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="7.00"
	Name="SiegeEditor"
	SccProjectName="&quot;$/GPG/Projects/SiegeEditor&quot;, NQCGAAAA"
	SccAuxPath=""
	SccLocalPath="."
	SccProvider="MSSCCI:Perforce SCM"
	Keyword="MFCProj">
	<Platforms>
		<Platform
			Name="Win32"/>
	</Platforms>
	<Configurations>
		<Configuration
			Name="Debug|Win32"
			OutputDirectory="\temp\vc7\siegeeditor\Debug"
			IntermediateDirectory="\temp\vc7\siegeeditor\Debug"
			ConfigurationType="1"
			UseOfMFC="1"
			ATLMinimizesCRunTimeLibraryUsage="FALSE"
			CharacterSet="2">
			<Tool
				Name="VCCLCompilerTool"
				Optimization="0"
				PreprocessorDefinitions="WIN32,_DEBUG,_WINDOWS"
				BasicRuntimeChecks="3"
				RuntimeLibrary="1"
				BufferSecurityCheck="FALSE"
				UsePrecompiledHeader="3"
				PrecompiledHeaderThrough="PrecompEditor.h"
				PrecompiledHeaderFile="\temp\vc7\siegeeditor\Debug/SiegeEditor.pch"
				AssemblerListingLocation="\temp\vc7\siegeeditor\Debug/"
				ObjectFile="\temp\vc7\siegeeditor\Debug/"
				ProgramDataBaseFileName="\temp\vc7\siegeeditor\Debug/"
				WarningLevel="3"
				SuppressStartupBanner="TRUE"
				DebugInformationFormat="3"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				AdditionalOptions="/MACHINE:I386 /force:multiple"
				AdditionalDependencies="dplayx.lib ddraw.lib d3dim.lib comctl32.lib"
				OutputFile="Debug/SiegeEditorD.exe"
				LinkIncremental="1"
				SuppressStartupBanner="TRUE"
				IgnoreDefaultLibraryNames="msvcrt.lib"
				GenerateDebugInformation="TRUE"
				ProgramDatabaseFile="\temp\vc7\siegeeditor\Debug/SiegeEditorD.pdb"
				SubSystem="2"/>
			<Tool
				Name="VCMIDLTool"
				PreprocessorDefinitions="_DEBUG"
				MkTypLibCompatible="TRUE"
				SuppressStartupBanner="TRUE"
				TargetEnvironment="1"
				TypeLibraryName="\temp\vc7\siegeeditor\Debug/SiegeEditor.tlb"/>
			<Tool
				Name="VCPostBuildEventTool"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"
				PreprocessorDefinitions="_DEBUG"
				Culture="1033"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCWebDeploymentTool"/>
		</Configuration>
		<Configuration
			Name="Release|Win32"
			OutputDirectory="\temp\vc7\siegeeditor\Release"
			IntermediateDirectory="\temp\vc7\siegeeditor\Release"
			ConfigurationType="1"
			UseOfMFC="1"
			ATLMinimizesCRunTimeLibraryUsage="FALSE"
			CharacterSet="2">
			<Tool
				Name="VCCLCompilerTool"
				InlineFunctionExpansion="1"
				PreprocessorDefinitions="WIN32,NDEBUG,_WINDOWS"
				StringPooling="TRUE"
				RuntimeLibrary="0"
				BufferSecurityCheck="FALSE"
				EnableFunctionLevelLinking="TRUE"
				UsePrecompiledHeader="3"
				PrecompiledHeaderThrough="PrecompEditor.h"
				PrecompiledHeaderFile="\temp\vc7\siegeeditor\Release/SiegeEditor.pch"
				AssemblerListingLocation="\temp\vc7\siegeeditor\Release/"
				ObjectFile="\temp\vc7\siegeeditor\Release/"
				ProgramDataBaseFileName="\temp\vc7\siegeeditor\Release/"
				WarningLevel="3"
				SuppressStartupBanner="TRUE"
				DebugInformationFormat="3"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				AdditionalOptions="/MACHINE:I386"
				AdditionalDependencies="shmfc4mt.lib shlw32mt.lib dplayx.lib ddraw.lib d3dim.lib comctl32.lib comctl32.lib"
				OutputFile="Release/SiegeEditor.exe"
				LinkIncremental="1"
				SuppressStartupBanner="TRUE"
				IgnoreDefaultLibraryNames="msvcrt.lib"
				GenerateDebugInformation="TRUE"
				ProgramDatabaseFile="\temp\vc7\siegeeditor\Release/SiegeEditor.pdb"
				SubSystem="2"/>
			<Tool
				Name="VCMIDLTool"
				PreprocessorDefinitions="NDEBUG"
				MkTypLibCompatible="TRUE"
				SuppressStartupBanner="TRUE"
				TargetEnvironment="1"
				TypeLibraryName="\temp\vc7\siegeeditor\Release/SiegeEditor.tlb"/>
			<Tool
				Name="VCPostBuildEventTool"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"
				PreprocessorDefinitions="NDEBUG"
				Culture="1033"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCWebDeploymentTool"/>
		</Configuration>
	</Configurations>

            , CHECKED
            MENUITEM "Logical Nodes",               ID_VIEW_MODE_LOGICALNODES

        END
        MENUITEM SEPARATOR
        MENUITEM "&Mesh Previewer",             ID_VIEW_MESHPREVIEWER
        MENUITEM SEPARATOR
        MENUITEM "&Keyboard Shortcuts",         ID_VIEW_KEYBOARDSHORTCUTS
        MENUITEM "Camera Controller",           ID_VIEW_CAMERACONTROLLER
        MENUITEM "Debug HUDs",                  ID_VIEW_DEBUGHUDS

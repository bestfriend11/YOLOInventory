IDD_NETWORK_TRANSPORT_TEST_DIALOG DIALOGEX 0, 0, 202, 181
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Network_transport_test"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "Exit",IDEXIT,145,160,50,14
    COMBOBOX        IDC_SESSIONSCOMBO,6,45,189,95,CBS_DROPDOWN | CBS_SORT | 
                    WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "List Sessions",IDC_LISTSESSIONS,91,34,47,9,BS_CENTER
    PUSHBUTTON      "Create and Open Session",IDC_CREATEANDOPENSESSION,102,
                    65,93,9
    PUSHBUTTON      "List Connections",IDC_LISTCONNECTIONS,77,94,59,10,
                    BS_CENTER
    EDITTEXT        IDC_NEWSESSIONNAME,6,76,189,12,ES_AUTOHSCROLL
    PUSHBUTTON      "List Providers",IDC_LISTPROVIDERS,104,3,49,10,BS_RIGHT
    COMBOBOX        IDC_PROVIDERLIST,6,15,189,61,CBS_DROPDOWN | WS_VSCROLL | 
                    WS_TABSTOP
    PUSHBUTTON      "Create connection",IDC_CREATECONNECTION,123,127,72,9
    EDITTEXT        IDC_NEWCONNECTIONNAME,6,138,189,12,ES_AUTOHSCROLL
    PUSHBUTTON      "Reset Network_transport",IDC_RESETNETWORKTRANSPORT,6,
                    163,91,11
    PUSHBUTTON      "Open Session",IDC_OPENSESSION,138,34,57,9,BS_CENTER
    PUSHBUTTON      "Close Connection",IDC_CLOSECONNECTION,136,94,59,10,
                    BS_CENTER

[GIANT_RAT1]
{
	type		= actor;
	name		= GlobalRat;
	commonname	= giant_rat;
	model		= c_edm_gr;
	tempside	= evil;
	race		= monster;

	[STATS*]
	{
		type			= stats;

		int			= 10;
		str			= 17;
		dex			= 12;

		life			= 100.0;
		liferate		= 20.0;
		mana			= 50.0;
		manarate		= 6.0;

		oneshot			= false;
		losattack		= true;
		rangedattack		= false;
		basedamage		= 5.0;
		attackrange		= 0.0;
		repetitiondelay		= 0.0;

		avespeed		= 1.5;
		maxspeed		= 3.0;

		sightangle		= 180.0;
		sightrange		= 12.0;

		iscollidable		= true;
		pitch			= 1.0f;

		//example: sound* = <event>,<subevent>,<soundfile>,<pitch>;
		sound*		= attack, default, ogre_attack1, 1.0;
		sound*		= attack, default, ogre_attack2, 1.0;
		sound*		= attack, default, ogre_attack3, 1.0;
		sound*		= attack, default, ogre_attack4, 1.0;
		sound*		= die, default, MonsterDie, 1.0;
	}
}




[YETI1]
{
	type		= actor;
	name		= GlobalYeti;
	commonname	= yeti;
	model		= c_edm_yt;
	tempside	= evil;
	race		= monster;

	brain		= brain_monster_generic;
	voice		= voice_generic;

	dictionary* = anim_pick_up_right	,c_edm_yt_fs0_ds;
	dictionary* = anim_pick_up_left		,c_edm_yt_fs0_ds;

    	dictionary* = anim_fs0			,c_edm_yt_fs1;
	dictionary* = anim_fs0_wl		,c_edm_yt_fs1_wl;
	dictionary* = anim_fs0_rl		,c_edm_yt_fs1_rl;
	dictionary* = anim_fs0_ds		,c_edm_yt_fs1_ds;
	dictionary* = anim_fs0_attack_1		,c_edm_yt_fs1_at_1;
	dictionary* = anim_fs0_defend_1		,c_edm_yt_fs1_df_1;
	dictionary* = anim_fs0_die_1		,c_edm_yt_fs1_di_1;
	dictionary* = anim_fs0_fidget_1		,c_edm_yt_fs1_fg_1;
	dictionary* = anim_fs0_magic_1		,c_edm_yt_fs1_mg_1;

        dictionary* = anim_fs1			,c_edm_yt_fs1;
	dictionary* = anim_fs1_wl		,c_edm_yt_fs1_wl;
	dictionary* = anim_fs1_rl		,c_edm_yt_fs1_rl;
	dictionary* = anim_fs1_ds		,c_edm_yt_fs1_ds;
	dictionary* = anim_fs1_attack_1		,c_edm_yt_fs1_at_1;
	dictionary* = anim_fs1_defend_1		,c_edm_yt_fs1_df_1;
	dictionary* = anim_fs1_die_1		,c_edm_yt_fs1_di_1;
	dictionary* = anim_fs1_fidget_1		,c_edm_yt_fs1_fg_1;
	dictionary* = anim_fs1_magic_1		,c_edm_yt_fs1_mg_1;


	[STATS*]
	{
		type			= stats;

		int			= 10;
		str			= 25;
		dex			= 12;

		life			= 100.0;
		liferate		= 20.0;
		mana			= 50.0;
		manarate		= 6.0;

		oneshot			= false;
		losattack		= true;
		rangedattack		= false;
		basedamage		= 5.0;
		attackrange		= 0.0;
		repetitiondelay		= 0.0;

		avespeed		= 1.5;
		maxspeed		= 3.0;

		sightangle		= 180.0;
		sightrange		= 12.0;

		iscollidable		= true;
		pitch			= 1.0f;

		//example: sound* = <event>,<subevent>,<soundfile>,<pitch>;
		sound*		= attack, default, ogre_attack1, 1.0;
		sound*		= attack, default, ogre_attack2, 1.0;
		sound*		= attack, default, ogre_attack3, 1.0;
		sound*		= attack, default, ogre_attack4, 1.0;
		sound*		= die, default, MonsterDie, 1.0;
	}
}

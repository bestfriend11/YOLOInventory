[t:actor,n:alpha]
{
	// test normal key/value pairs
	top_item1	= hooha1;
	top_item2	= hooha2;
	top_item3	= hooha3;

	// test wildcard pairs
	alpha_misc*	= misc1;
	alpha_misc*	= misc2;
	alpha_misc*	= misc3;

	// normal child block
	[alpha_child]
	{
		item1	= hooha1;
		item2	= hooha2;
		item3	= hooha3;

		alpha_child_misc*=misc1;
		alpha_child_misc*=misc2;
		alpha_child_misc*=misc3;
	}

	// wildcard child blocks

	[alpha_child*]
	{
		mics_child_param1= 1;
	}

	[alpha_child*]
	{
		mics_child_param2= 2;
	}

	[alpha_child*]
	{
		mics_child_param3 = 3;
	}
}


@echo off
setlocal

call %@PATH[ %_BATCHNAME ]\set_config.btm
if errorlevel 1 quit

*md %out >&NUL
*md %out\Loc >&NUL
*del /q /e /y %out\Loc

pushd
cd %out\Loc

:: //////////////////////////////////////////////////////////////////////////

echo Syncing latest loc files...
echo.
p4 sync -f  %p4tree/gpg/batch/make_tank.gas#head
*copy /q      %tree\gpg\batch\make_tank.gas
p4 sync -f  %p4tree/gpg/batch/make_language_tank.bat#head
*copy /q      %tree\gpg\batch\make_language_tank.bat
p4 sync -f  %p4tree/tools/codeloc.exe#head
:: // don't copy codeloc, loc teams don't need it
p4 sync -f  %p4tree/tools/textloc.exe#head
*copy /q      %tree\tools\textloc.exe
p4 sync -f  %p4tree/tools/uiloc.exe#head
*copy /q      %tree\tools\uiloc.exe
p4 sync -f  %p4tree/build/tankbuilder.exe#head
*copy /q      %tree\build\tankbuilder.exe
p4 sync -f  %p4tree/tools/loc_extra_tools.zip#head
*copy /q      %tree\tools\loc_extra_tools.zip
p4 sync -f  %p4tree/cdimage/lqd_dictionary.ldc6#head
*copy /q      %tree\cdimage\lqd_dictionary.ldc6
p4 sync -f "%p4tree/docs/loc/...#head
*copy /q     "%tree\docs\loc\*

echo.
echo Syncing latest loc-dependent data and code...
echo.
p4 sync %p4tree/gpg/...
p4 sync %p4tree/cdimage/ui/...
p4 sync %p4tree/cdimage/world/ai/...
p4 sync %p4tree/cdimage/world/contentdb/...
p4 sync %p4tree/cdimage/world/global/...
p4 sync %p4tree/cdimage/world/maps/map_world/...
p4 sync %p4tree/cdimage/world/maps/multiplayer_world/...

:: //////////////////////////////////////////////////////////////////////////

echo.
echo Creating LANGUAGE.DLL
echo.
%tree\tools\codeloc %tree\gpg language.dll
echo.
echo Done!

echo.
echo Creating TEXT.DLL (this takes a while)...
echo.
%tree\tools\textloc %tree\cdimage
echo.
echo Done!

echo.
echo Creating UI.DLL and LOCALIZATION_UI_MAP.GAS...
echo.
%tree\tools\uiloc %tree\cdimage
echo.
echo Done!
echo.

*del /q /e temp.rc
*del /q /e temp.res

:: //////////////////////////////////////////////////////////////////////////

popd

:: //////////////////////////////////////////////////////////////////////////

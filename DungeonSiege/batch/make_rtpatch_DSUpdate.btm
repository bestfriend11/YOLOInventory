call %@PATH[ %_BATCHNAME ]\set_config.btm


echo *************************************
echo ***
echo ***	Set the directory to copy the
echo ***	tanks from
echo ***	you can change this value to 
echo ***	the 02.07.0101 form
echo ***
echo **************************************

set currentBuild = main_02.07.0101



echo *************************************
echo ***
echo ***	make temp directories
echo ***
echo **************************************

mkdir %root%\ds1\main\installs\RTPatchUpdate\NewVersion
mkdir %root%\ds1\main\installs\RTPatchUpdate\NewVersion\Maps
mkdir %root%\ds1\main\installs\RTPatchUpdate\NewVersion\Resources

echo *************************************
echo ***
echo ***	copy over the patched files
echo ***
echo **************************************

*copy /u /e /z /k   \\tankbox\testing_data\current\ds1_%currentBuild%_tank\dbghelp.dll			%root%\ds1\main\installs\RTPatchUpdate\NewVersion\dbghelp.dll
*copy /u /e /z /k   \\tankbox\testing_data\current\ds1_%currentBuild%_tank\Maps\MpWorld.dsmap	%root%\ds1\main\installs\RTPatchUpdate\NewVersion\Maps\MpWorld.dsmap
*copy /u /e /z /k   \\tankbox\testing_data\current\ds1_%currentBuild%_tank\Maps\World.dsmap		%root%\ds1\main\installs\RTPatchUpdate\NewVersion\Maps\World.dsmap

*copy /u /e /z /k   \\tankbox\testing_data\current\ds1_%currentBuild%_tank\Resources\Logic.dsres	%root%\ds1\main\installs\RTPatchUpdate\NewVersion\Resources\Logic.dsres
*copy /u /e /z /k   \\tankbox\testing_data\current\ds1_%currentBuild%_tank\Resources\Objects.dsres	%root%\ds1\main\installs\RTPatchUpdate\NewVersion\Resources\Objects.dsres
*copy /u /e /z /k   \\tankbox\testing_data\current\ds1_%currentBuild%_tank\Resources\Sound.dsres	%root%\ds1\main\installs\RTPatchUpdate\NewVersion\Resources\Sound.dsres
*copy /u /e /z /k   \\tankbox\testing_data\current\ds1_%currentBuild%_tank\Resources\Terrain.dsres	%root%\ds1\main\installs\RTPatchUpdate\NewVersion\Resources\Terrain.dsres

echo *************************************
echo ***
echo ***	create the patch --  this will
echo ***	take between 1-2 hours
echo ***
echo **************************************

cd %root\ds1\main\installs\RTPatchUpdate\

patchbld @%root\ds1\main\installs\RTPatchUpdate\DSUpdateRTPatch_RTM_current.cmd
patchbld @%root\ds1\main\installs\RTPatchUpdate\DSUpdateRTPatch_previous_current.cmd

pbind.exe %root\ds1\main\installs\RTPatchUpdate\DSUpdateRTPatch_RTM_current.bsr %root\ds1\main\installs\RTPatchUpdate\pbindwin.exe
pbind.exe %root\ds1\main\installs\RTPatchUpdate\DSUpdateRTPatch_previous_current.bsr %root\ds1\main\installs\RTPatchUpdate\pbindwin.exe


echo *************************************
echo ***
echo ***	create the wrapper around the patch 
echo ***
echo **************************************

make_install_DSUpdateWrapper \\tankbox\testing_data\current\ds1_main_%currentBuild%_tank


pause

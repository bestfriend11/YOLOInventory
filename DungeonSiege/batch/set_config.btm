:: ///////////////////////////////////////////////////////////////////////////

set batchpath=%@PATH[ %_BATCHNAME ]
set config=%batchpath%config\%COMPUTERNAME%.cfg

:: ///////////////////////////////////////////////////////////////////////////
:: set config vars

iff not exist %config then
	echo.
	echo Fatal: this computer not set up for batched execution!
	echo [Missing file %config]
	echo.
	quit 1
endiff

set /r %config

:: ///////////////////////////////////////////////////////////////////////////
:: detect client root

iff not defined root then
	set tmpfile=%@UNIQUE[]
	p4 client -o %p4client >>%tmpfile
	for /f "tokens=1,2" %a in (%tmpfile) do (
		iff "%a"=="Root:" then
			set root=%b
		endiff
	)
	*del /q /y %tmpfile
endiff

:: ///////////////////////////////////////////////////////////////////////////

iff not defined root .or. not direxist %root then
	echo.
	echo Fatal: %config not configured properly!
	echo ["root" (%root) not configured or cannot be detected from P4, or is invalid]
	echo.
	quit 1
endiff

set codetemp=%@LEFT[3,%root]
iff not defined codetemp .or. not direxist %codetemp then
	echo.
	echo Fatal: unexpected path type
	echo ["codetemp" (%codetemp) extracted from root (%root) refers to invalid dir]
	echo.
	quit 1
endiff

set codetemp=%codetemp%temp

if not defined vctype set vctype=6

set project=ds1
set branch=main
set tree=%root\%project\%branch
set p4tree=//depot/%project/%branch
set out=%tree\out
set cl=@%tree\gpg\msdev.opt

iff %vctype==6 then
	set path=%path;%tree\gpg\bin;%root\tools\build6\vc6\bin;%root\tools\build6\vstudio\common\msdev98\bin;%root\tools\build6\vstudio\common\tools
	set include=%root\tools\psdk\include\prerelease;%root\tools\psdk\include;%root\tools\build6\vc6\include;%root\tools\build6\vc6\atl\include;%root\tools\build6\vc6\mfc\include
	set lib=%tree\gpg\lib;%root\tools\psdk\lib\prerelease;%root\tools\psdk\lib;%root\tools\build6\vc6\lib;%root\tools\build6\vc6\mfc\lib
endiff

*md %out >&NUL
*md %out\Logs >&NUL
*md %out\Loc >&NUL
*md %out\Maps >&NUL
*md %out\Resources >&NUL

*del /q /e %out\Logs\EnvVars.log
set >%out\Logs\EnvVars.log

:: ///////////////////////////////////////////////////////////////////////////

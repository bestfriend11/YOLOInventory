//////////////////////////////////////////////////////////////////////////////

[language]
{
	file				= "Language.dsres";
	title				= "Dungeon Siege Language Support";
	specializes			= globals;
	priority			= language;

	[format*]
	{
		format			= zlib;
		include*		= *;
		exclude*		= *.wav, *.mp3, *.bik, *.avi;
	}

	[input*]
	{
		input_root		= %base_root%\config+;
	}

	[input*]
	{
		input_root		= %base_root%\language+;
	}
}


call %@PATH[ %_BATCHNAME ]\set_config.btm

echo **************************************************
echo *** copy the files we need for the install
echo **************************************************
echo .
echo .
*copy /u /e /z /k  %root%\ds1\main\installs\RtPatchUpdate\DSUpdateRTPatch_RTM_current.exe		%root%\ds1\main\installs\DSUpdateWrapper\data\DSRTPatch10010902.exe
*copy /u /e /z /k  %root%\ds1\main\installs\RtPatchUpdate\DSUpdateRTPatch_previous_current.exe	%root%\ds1\main\installs\DSUpdateWrapper\data\DSRTPatch109b10902.exe

*copy /u /e /z /k  %1\DungeonSiege.exe 								%root%\ds1\main\installs\DSUpdateWrapper\data\DungeonSiege.exe
*copy /u /e /z /k  %1\DSvideoConfig.exe 							%root%\ds1\main\installs\DSUpdateWrapper\data\DSvideoConfig.exe
*copy /u /e /z /k  %1\EbuEula.dll 									%root%\ds1\main\installs\DSUpdateWrapper\data\EbuEula.dll
*copy /u /e /z /k  %1\Eula.rtf 										%root%\ds1\main\installs\DSUpdateWrapper\data\Eula.rtf
*copy /u /e /z /k  %1\system_detail.gas 							%root%\ds1\main\installs\DSUpdateWrapper\data\system_detail.gas
*copy /u /e /z /k  %1\Warranty.rtf 									%root%\ds1\main\installs\DSUpdateWrapper\data\Warranty.rtf
*copy /u /e /z /k  "%1\Save Games\Where Are My Saved Games.txt" 		"%root%\ds1\main\installs\DSUpdateWrapper\data\Save Games\Where Are My Saved Games.txt"

echo **************************************************
echo *** getting the install files.
echo **************************************************
echo .
echo .
p4 sync -f %p4tree/installs/DSUpdateWrapper...#head


echo **************************************************
echo ***
echo ***	If you get the error:
echo *** "A corrupt or invalid licence was detected, please reinstall the sofware"
echo *** You will need to run wise9.exe at least one time from this machine. 
echo ***	To set up the licencing info.
echo ***	The Serial Number is: 900 5562769
echo ***
echo ***	
echo ***	Check the top of the file to make sure the script can find your cfg file, if not
echo ***	create a cfg file using \\depot\ds1\main\gpg\batch\configroadrunner.cfg
echo ***	as a template.
echo ***	
echo **************************************************
echo .
echo .


echo **************************************************
echo *** setting z, wise needs this.
echo **************************************************
echo .
echo .
subst "z:" %root%\


echo **************************************************
echo *** building the installer
echo **************************************************
echo .
echo .
"z:\tools\wise\Wise32.exe" /c /s "%root%\ds1\main\installs\DSUpdateWrapper\DSUpdateWrapper.wse"
"z:\tools\wise\Wise32.exe" /c /s "%root%\ds1\main\installs\DSUpdateWrapper\DSUpdateWrapperPrevious.wse"

pause


:: //////////////////////////////////////////////////////////////////////////

@echo off
setlocal

set batchpath=%@PATH[ %_BATCHNAME ]
call %batchpath\set_config.btm
if errorlevel 1 quit

set tankbuilder=%tree\build\tankbuilder.exe
set versionpath=%tree\gpg\projects\tattoo\exe\retail
set fallbackvpath=%tree\gpg\projects\tattoo\services\tattooversion.h

:: //////////////////////////////////////////////////////////////////////////
:: // main menu

echo ======================================================================
echo.
echos Retail, dev, or NO tanks?            (r/d/n):
inkey /c /k"rdn" %%tank_type
echos Sync P4 into local workspace?        (y/n):
inkey /c /k"yn" %%sync_p4

iff %tank_type==n .AND. %sync_p4==n then
	echo.
	echos Nothing to do! You crazy!
	echo.
	quit
endiff

iff %sync_p4==y then
	echos Delete assets from hard drive first? (y/n):
	inkey /c /k"yn" %%del_assets
	if %del_assets==y set p4refresh=-f
endiff

echos Process ALL groups?                  (y/n):
inkey /c /k"yn" %%process_all

iff %process_all=n then
	echos Process TERRAIN?                     (y/n):
	inkey /c /k"yn" %%process_terrain
	echos Process OBJECTS?                     (y/n):
	inkey /c /k"yn" %%process_objects
	echos Process SOUND?                       (y/n):
	inkey /c /k"yn" %%process_sound
	echos Process VOICES?                      (y/n):
	inkey /c /k"yn" %%process_voices
	echos Process LOGIC?                       (y/n):
	inkey /c /k"yn" %%process_logic
	echos Process MAP_WORLD map?               (y/n):
	inkey /c /k"yn" %%process_map_world
	echos Process MULTIPLAYER_WORLD map?       (y/n):
	inkey /c /k"yn" %%process_multiplayer_world
	echos Process MARSH_TEST map?              (y/n):
	inkey /c /k"yn" %%process_marsh_test
	echos Process MULTIPLAYER_SCOTT_TEST map?  (y/n):
	inkey /c /k"yn" %%process_multiplayer_scott_test
	echos Process MONSTER_MUSEUM map?          (y/n):
	inkey /c /k"yn" %%process_monster_museum
	echos Process OBJECT_MUSEUM map?           (y/n):
	inkey /c /k"yn" %%process_object_museum
	echos Process GP_STRESS map?               (y/n):
	inkey /c /k"yn" %%process_gp_stress
	echos Process UBER_TEST map?               (y/n):
	inkey /c /k"yn" %%process_uber_test
	echos Process YESTERHAVEN?                 (y/n):
	inkey /c /k"yn" %%process_yesterhaven
	echos Process DSX?                         (y/n):
	inkey /c /k"yn" %%process_dsx
	echos Process GREMAL_HUNTER?               (y/n):
	inkey /c /k"yn" %%process_gremal_hunter
	echos Process BENCHMARK?                   (y/n):
	inkey /c /k"yn" %%process_benchmark
	echos Process LOOPING_DEMO?                (y/n):
	inkey /c /k"yn" %%process_looping_demo
endiff

echo.
echo ======================================================================

iff %tank_type==d then
	set devmode=-dev
endiff

set tankoptions=%devmode -dump -verify -nologo -home %batchpath -out %out -build -nobak -is_gpg -version_path %versionpath -fallback_version_path %fallbackvpath

:: //////////////////////////////////////////////////////////////////////////
:: // delete and fetch from P4

iff %sync_p4==y then
	iff %process_all==y then
		set working=cdimage
		gosub delete_and_fetch
		echo Moving veteran/elite files...
		perl %tree\tools\world_7_build_tool.pl %tree\cdimage\world\maps\multiplayer_world
	else
		iff %process_terrain==y then
			set working=cdimage\art\terrain
			gosub delete_and_fetch
			set working=cdimage\art\bitmaps\terrain
			gosub delete_and_fetch
			set working=cdimage\world\global\siege_nodes
			gosub delete_and_fetch
		endiff
		iff %process_objects==y then
			set working=cdimage\art\animations
			gosub delete_and_fetch
			set working=cdimage\art\bitmaps
			gosub delete_and_fetch
			set working=cdimage\art\meshes
			gosub delete_and_fetch
			set working=cdimage\movies
			gosub delete_and_fetch
		endiff
		iff %process_sound==y then
			set working=cdimage\sound\effects
			gosub delete_and_fetch
			set working=cdimage\sound\music
			gosub delete_and_fetch
		endiff
		iff %process_sound==y then
			set working=cdimage\sound\voices
			gosub delete_and_fetch
		endiff
		iff %process_logic==y then

			:: // get subdirs
			set working=cdimage\art\animations\skrits
			gosub delete_and_fetch
			set working=cdimage\auto
			gosub delete_and_fetch
			set working=cdimage\config
			gosub delete_and_fetch
			set working=cdimage\ui
			gosub delete_and_fetch
			set working=cdimage\world\ai
			gosub delete_and_fetch
			set working=cdimage\world\contentdb
			gosub delete_and_fetch
			set working=cdimage\world\global
			gosub delete_and_fetch

			:: // get contents of root dir only
			iff %del_assets==y then
				*del /q /e /y /x /z %tree\cdimage
			endiff
			p4 sync %p4refresh %p4tree/cdimage/*#head

			:: // get contents of art dir only
			iff %del_assets==y then
				*del /q /e /y /x /z %tree\cdimage\art
			endiff
			p4 sync %p4refresh %p4tree/cdimage/art/*#head

		endiff
		iff %process_map_world==y then
			set working=cdimage\world\maps\map_world
			gosub delete_and_fetch
		endiff
		iff %process_multiplayer_world==y then
			set working=cdimage\world\maps\multiplayer_world
			gosub delete_and_fetch
			echo Moving veteran/elite files...
			perl %tree\tools\world_7_build_tool.pl %tree\cdimage\world\maps\multiplayer_world
		endiff
		iff %process_marsh_test==y then
			set working=cdimage\world\maps\marsh_test
			gosub delete_and_fetch
		endiff
		iff %process_multiplayer_scott_test==y then
			set working=cdimage\world\maps\multiplayer_scott_test
			gosub delete_and_fetch
		endiff
		iff %process_monster_museum==y then
			set working=cdimage\world\maps\monster_museum
			gosub delete_and_fetch
		endiff
		iff %process_object_museum==y then
			set working=cdimage\world\maps\object_museum
			gosub delete_and_fetch
		endiff
		iff %process_gp_stress==y then
			set working=cdimage\world\maps\gp_stress
			gosub delete_and_fetch
		endiff
		iff %process_uber_test==y then
			set working=cdimage\world\maps\uber_test
			gosub delete_and_fetch
		endiff
	endiff

	iff %process_yesterhaven==y .OR. %process_all==y then
		set working=extras\yesterhaven
		gosub delete_and_fetch
	endiff
	
	iff %process_dsx==y .OR. %process_all==y then
		set working=extras\dsx
		gosub delete_and_fetch
	endiff

	iff %process_gremal_hunter==y .OR. %process_all==y then
		set working=extras\gremal_hunter
		gosub delete_and_fetch
	endiff
	
	iff %process_benchmark==y .OR. %process_all==y then
		set working=extras\benchmark
		gosub delete_and_fetch
	endiff

	iff %process_looping_demo==y .OR. %process_all==y then
		set working=extras\looping_demo
		gosub delete_and_fetch
	endiff
endiff

:: //////////////////////////////////////////////////////////////////////////
:: // make sure those dirs still exist

*md /s %tree >&>NUL
*md /s %tree\cdimage >&>NUL
*md /s %tree\tools >&>NUL
*md /s %out >&NUL
*md /s %out\Resources >&>NUL
*md /s %out\Maps >&>NUL
*md /s %out\Logs >&>NUL

:: //////////////////////////////////////////////////////////////////////////
:: // fetch latest and build tanks

iff not %tank_type==n then

	echo.
	echo Syncing latest version info...
	echo.
	p4 sync %fallbackvpath
	echo.

	set working_root=cdimage
	set journal=-journal %batchpath\tattoo_file_journal.log

	iff %process_terrain==y .OR. %process_all==y then
		set working=terrain
		gosub build_tank
	endiff
	iff %process_objects==y .OR. %process_all==y then
		set working=objects
		gosub build_tank
	endiff
	iff %process_sound==y .OR. %process_all==y then
		set working=sound
		gosub build_tank
	endiff
	iff %process_voices==y .OR. %process_all==y then
		set working=voices
		gosub build_tank
	endiff
	iff %process_logic==y .OR. %process_all==y then
		set working=logic
		gosub build_tank
		set working=dev_logic
		gosub build_tank
		set working=se_extras
		gosub build_tank
	endiff
	iff %process_map_world==y .OR. %process_all==y then
		set working=map_world
		gosub build_tank
	endiff
	iff %process_multiplayer_world==y .OR. %process_all==y then
		set working=multiplayer_world
		gosub build_tank
	endiff
	iff %process_marsh_test==y .OR. %process_all==y then
		set working=marsh_test
		gosub build_tank
	endiff
	iff %process_multiplayer_scott_test==y .OR. %process_all==y then
		set working=multiplayer_scott_test
		gosub build_tank
	endiff
	iff %process_monster_museum==y .OR. %process_all==y then
		set working=monster_museum
		gosub build_tank
	endiff
	iff %process_object_museum==y .OR. %process_all==y then
		set working=object_museum
		gosub build_tank
	endiff
	iff %process_gp_stress==y .OR. %process_all==y then
		set working=gp_stress
		gosub build_tank
	endiff
	iff %process_uber_test==y .OR. %process_all==y then
		set working=uber_test
		gosub build_tank
	endiff

	set working_root=extras/yesterhaven/cdimage
	set journal=

	iff %process_yesterhaven==y .OR. %process_all==y then
		set working=yesterhaven_map
		gosub build_tank
		set working=yesterhaven_mod
		gosub build_tank
	endiff

	set working_root=extras/dsx/cdimage
	set journal=

	iff %process_dsx==y .OR. %process_all==y then
		set working=dsx_map
		gosub build_tank
		set working=dsx_mod
		gosub build_tank
	endiff

	set working_root=extras/gremal_hunter/cdimage
	set journal=

	iff %process_gremal_hunter==y .OR. %process_all==y then
		set working=gremal_hunter_map
		gosub build_tank
		set working=gremal_hunter_mod
		gosub build_tank
	endiff

	set working_root=extras/benchmark/cdimage
	set journal=

	iff %process_benchmark==y .OR. %process_all==y then
		set working=benchmark_map
		gosub build_tank
		set working=benchmark_mod
		gosub build_tank
	endiff

	set working_root=extras/looping_demo/cdimage
	set journal=

	iff %process_looping_demo==y .OR. %process_all==y then
		set working=looping_demo_map
		gosub build_tank
		set working=looping_demo_mod
		gosub build_tank
	endiff

:: // move tanks into 'resources' and 'maps' subdirs
	move %out\*.dsres %out\resources >&>NUL
	move %out\*.dsmap %out\maps >&>NUL
	move %out\*.txt %out\logs >&>NUL

endiff

:: //////////////////////////////////////////////////////////////////////////
:: // done, exit

echo.
echo Done!

iff %notify_completion==y then
	net send bertb "TANK's built!"
endiff

quit

:: //////////////////////////////////////////////////////////////////////////
:: // SUB: delete_and_fetch

:delete_and_fetch

iff %del_assets==y then
	echo.
	echo Deleting assets from %working...
	echo.
	*del /q /e /y /s /x /z %tree\%working
endiff

*md /s %tree\%working >&>NUL

echo.
echo Syncing assets into %working...
echo.
p4 sync %p4refresh %p4tree/%@REPLACE[\,/,%working]/...#head

return

:: //////////////////////////////////////////////////////////////////////////
:: // SUB: build_tank

:build_tank

echo.
echo Building %@UPPER[%working] tank...
echo.
%tankbuilder %tankoptions -config %working -in %tree/%working_root+ %journal

return

:: //////////////////////////////////////////////////////////////////////////

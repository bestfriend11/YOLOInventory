call %@PATH[ %_BATCHNAME ]\set_config.btm

echo **************************************************
echo *** copy the files we need for the install
echo **************************************************
echo .
echo .

*copy /u /e /z /k  \\conan\projects\tattoo\tools\Siege_Editor\RTW\DungeonSiegeR.exe		%root\ds1\main\installs\SiegeEditor\data\DungeonSiegeR.exe
*copy /u /e /z /k  \\conan\projects\tattoo\tools\Siege_Editor\RTW\SiegeEditor.exe		%root\ds1\main\installs\SiegeEditor\data\SiegeEditor.exe
*copy /u /e /z /k  \\conan\projects\tattoo\tools\Siege_Editor\RTW\SiegeEditorExtras.dsres %root\ds1\main\installs\SiegeEditor\data\SiegeEditorExtras.dsres

*copy /u /e /z /k /s  \\biddle2\xfers\for_installation\_GMAXLOC_\				%root\ds1\main\installs\SiegeEditor\data\_GMAXLOC_\
*copy /u /e /z /k /s  \\biddle2\xfers\for_installation\dungeon_siege_toolkit\	%root\ds1\main\installs\SiegeEditor\data

echo **************************************************
echo *** getting the install files.
echo **************************************************
echo .
echo .
p4 sync -f %p4tree%/installs/SiegeEditor...#head


echo **************************************************
echo ***
echo ***	If you get the error:
echo *** "A corrupt or invalid licence was detected, please reinstall the sofware"
echo *** You will need to run wise9.exe at least one time from this machine. 
echo ***	To set up the licencing info.
echo ***	The Serial Number is: 900 5562769
echo ***
echo ***	
echo ***	Check the top of the file to make sure the script can find your cfg file, if not
echo ***	create a cfg file using \\depot\ds1\main\gpg\batch\configroadrunner.cfg
echo ***	as a template.
echo ***	
echo **************************************************
echo .
echo .


echo **************************************************
echo *** setting z, wise needs this.
echo **************************************************
echo .
echo .
subst "z:" %root%\


echo **************************************************
echo *** building the installer
echo **************************************************
echo .
echo .
"z:\tools\wise\Wise32.exe" /c /s "%root\ds1\main\installs\SiegeEditor\DungeonSiegeToolkit.wse"

pause

#pragma once

// ------------------------------------------------------------------
// YOLOInventory - Grid shader helpers
// Intended for use from Material Custom nodes:
//   #include "/Plugin/YOLOInventory/InventoryGrid/YIInventoryGridCommon.ush"
// ------------------------------------------------------------------

float YI_Remap(float Value, float InMin, float InMax, float OutMin, float OutMax)
{
	const float T = saturate((Value - InMin) / max(0.0001, InMax - InMin));
	return lerp(OutMin, OutMax, T);
}

// Signed distance to axis-aligned box centered at 0.
float YI_SdBox(float2 P, float2 HalfSize)
{
	const float2 D = abs(P) - HalfSize;
	return length(max(D, 0.0)) + min(max(D.x, D.y), 0.0);
}

// Signed distance to rounded box centered at 0.
float YI_SdRoundedBox(float2 P, float2 HalfSize, float Radius)
{
	const float2 D = abs(P) - (HalfSize - Radius);
	return length(max(D, 0.0)) + min(max(D.x, D.y), 0.0) - Radius;
}

// Converts SDF into an anti-aliased mask (1 inside, 0 outside).
float YI_AAMaskFromSdf(float Distance, float EdgeSoftness)
{
	return saturate(1.0 - smoothstep(0.0, max(0.0001, EdgeSoftness), Distance));
}

// Subtle hover pulse. Speed in cycles/sec-like range (0.5..3).
float YI_HoverPulse(float Time, float Speed, float MinValue, float MaxValue)
{
	const float Sine01 = 0.5 + 0.5 * sin(Time * Speed * 6.2831853);
	return lerp(MinValue, MaxValue, Sine01);
}

// Dotted marquee around a normalized shape border.
// UV: 0..1 local cell space
// BorderMask: expected to be ~1 near border and 0 elsewhere
float YI_DottedMarquee(float2 UV, float BorderMask, float Time, float DotCount, float DotWidth, float ScrollSpeed)
{
	const float U = frac(UV.x + UV.y + Time * ScrollSpeed);
	const float DotIndex = frac(U * DotCount);
	const float Dot = 1.0 - smoothstep(DotWidth, DotWidth + 0.08, DotIndex);
	return BorderMask * Dot;
}

// Convenience: rounded-rectangle border mask in local UV.
float YI_RoundedRectBorder(float2 UV, float2 HalfSize, float Radius, float Thickness, float EdgeSoftness)
{
	const float2 P = (UV - 0.5) * 2.0;
	const float OuterSdf = YI_SdRoundedBox(P, HalfSize, Radius);
	const float InnerSdf = YI_SdRoundedBox(P, max(HalfSize - Thickness, 0.001), max(Radius - Thickness, 0.0));
	const float OuterMask = YI_AAMaskFromSdf(OuterSdf, EdgeSoftness);
	const float InnerMask = YI_AAMaskFromSdf(InnerSdf, EdgeSoftness);
	return saturate(OuterMask - InnerMask);
}

